{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MdView",
  "version": "0.1.0",
  "identifier": "com.tatsuma.mdview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MdView",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#141419"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "macOS": {
      "signingIdentity": "-"
    },
    "fileAssociations": [
      { "ext": ["md", "markdown", "mdx"], "name": "Markdown 文档", "role": "Editor", "mimeType": "text/markdown" },
      { "ext": ["txt"], "name": "文本文档", "role": "Editor", "mimeType": "text/plain" }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
